# Keep LF endings on checkout everywhere: the shell scripts need it, and
# tests/expected/ files are compared byte for byte against guest output.
* text=auto eol=lf
tests/expected/** -text
# The bundled CPython (browser demo) ships byte-for-byte: never touch line endings.
web/py/** -text
web/pylinux/** -text
web/pylinux-dyn/** -text
